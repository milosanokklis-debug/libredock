# set the timezone of the services
TZ=America/New_York
# setting the PUID for the process (arbirtary but needs to be different
PUID=1000
PGID=1000

# sets the database user and the database name for the librenms
MYSQL_DATABASE=librenms
MYSQL_USER=librenms
# sets the SQL password. CHANGE THIS ON INSTALL
MYSQL_PASSWORD=asupersecretpassword
